{
  "$schema": "https://spec.openapis.org/oas/3.0/schema/2021-09-28",
  "openapi": "3.0.3",
  "info": {
    "title": "AIWorkhive API v1",
    "version": "1.0.0",
    "description": "Stable v1 contract for UI session navigation, artifact access, and connector ingest."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/sessions": {
      "get": {
        "summary": "List sessions",
        "description": "Returns sessions with filter support and cursor-based pagination.",
        "operationId": "listSessions",
        "parameters": [
          {
            "$ref": "#/components/parameters/StatusFilter"
          },
          {
            "$ref": "#/components/parameters/RoleFilter"
          },
          {
            "$ref": "#/components/parameters/PageSize"
          },
          {
            "$ref": "#/components/parameters/Cursor"
          }
        ],
        "responses": {
          "200": {
            "description": "Session list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/sessions/{id}/next-block": {
      "get": {
        "summary": "Get next server-driven question block",
        "description": "Returns the next question block from the server for the current session and role. Question sets are resolved server-side.",
        "operationId": "getNextSessionBlock",
        "parameters": [
          {
            "$ref": "#/components/parameters/SessionId"
          }
        ],
        "responses": {
          "200": {
            "description": "Next question block",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NextBlockResponse"
                }
              }
            }
          },
          "404": {
            "description": "Session not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/artifacts": {
      "get": {
        "summary": "List artifacts",
        "description": "Returns artifacts with filter support and cursor-based pagination.",
        "operationId": "listArtifacts",
        "parameters": [
          {
            "$ref": "#/components/parameters/NameFilter"
          },
          {
            "$ref": "#/components/parameters/StatusFilter"
          },
          {
            "$ref": "#/components/parameters/PageSize"
          },
          {
            "$ref": "#/components/parameters/Cursor"
          }
        ],
        "responses": {
          "200": {
            "description": "Artifact list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArtifactListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/artifacts/{name}": {
      "get": {
        "summary": "Get artifact by name",
        "description": "Returns artifact facts and includes each fact's status, confidence, and source.",
        "operationId": "getArtifactByName",
        "parameters": [
          {
            "$ref": "#/components/parameters/ArtifactName"
          }
        ],
        "responses": {
          "200": {
            "description": "Artifact details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArtifactDetailResponse"
                }
              }
            }
          },
          "404": {
            "description": "Artifact not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/connector/ingest": {
      "post": {
        "summary": "Ingest connector event",
        "description": "Single allowed connector ingest route. Payloads are versioned and signed with a per-site token. Any message body fields are rejected by schema.",
        "operationId": "ingestConnectorEvent",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConnectorIngestRequestV1"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted for processing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectorIngestAcceptedResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid payload or unsupported version",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or missing per-site token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Payload rejected because message bodies are present",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "SessionId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "ArtifactName": {
        "name": "name",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "StatusFilter": {
        "name": "status",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string"
        },
        "description": "Optional status filter."
      },
      "RoleFilter": {
        "name": "role",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string"
        },
        "description": "Optional role filter for server-side question sets."
      },
      "NameFilter": {
        "name": "name",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string"
        },
        "description": "Optional artifact name filter."
      },
      "PageSize": {
        "name": "page_size",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        }
      },
      "Cursor": {
        "name": "cursor",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "nullable": true
        }
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "Pagination": {
        "type": "object",
        "required": ["page_size", "next_cursor"],
        "properties": {
          "page_size": {
            "type": "integer"
          },
          "next_cursor": {
            "type": ["string", "null"]
          }
        },
        "additionalProperties": false
      },
      "SessionSummary": {
        "type": "object",
        "required": ["id", "status", "role", "updated_at"],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "SessionListResponse": {
        "type": "object",
        "required": ["items", "pagination"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SessionSummary"
            }
          },
          "pagination": {
            "$ref": "#/components/schemas/Pagination"
          }
        },
        "additionalProperties": false
      },
      "QuestionBlock": {
        "type": "object",
        "required": ["block_id", "role", "questions"],
        "properties": {
          "block_id": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "questions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["question_id", "prompt", "type"],
              "properties": {
                "question_id": {
                  "type": "string"
                },
                "prompt": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "required": {
                  "type": "boolean"
                },
                "labels": {
                  "type": "object",
                  "description": "Accessibility labels and colours specifics are intentionally left for a later contract decision."
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      },
      "NextBlockResponse": {
        "type": "object",
        "required": ["session_id", "next_block"],
        "properties": {
          "session_id": {
            "type": "string"
          },
          "next_block": {
            "$ref": "#/components/schemas/QuestionBlock"
          }
        },
        "additionalProperties": false
      },
      "ArtifactSummary": {
        "type": "object",
        "required": ["name", "status", "updated_at"],
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "ArtifactListResponse": {
        "type": "object",
        "required": ["items", "pagination"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ArtifactSummary"
            }
          },
          "pagination": {
            "$ref": "#/components/schemas/Pagination"
          }
        },
        "additionalProperties": false
      },
      "ArtifactFact": {
        "type": "object",
        "required": ["fact_id", "value", "status", "confidence", "source"],
        "properties": {
          "fact_id": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "source": {
            "type": "object",
            "required": ["type", "id"],
            "properties": {
              "type": {
                "type": "string"
              },
              "id": {
                "type": "string"
              },
              "recorded_at": {
                "type": "string",
                "format": "date-time"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "ArtifactDetailResponse": {
        "type": "object",
        "required": ["name", "facts"],
        "properties": {
          "name": {
            "type": "string"
          },
          "facts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ArtifactFact"
            }
          }
        },
        "additionalProperties": false
      },
      "ConnectorIngestRequestV1": {
        "type": "object",
        "required": ["version", "site_token", "site_id", "signature", "payload"],
        "properties": {
          "version": {
            "type": "string",
            "enum": ["v1"]
          },
          "site_id": {
            "type": "string"
          },
          "site_token": {
            "type": "string",
            "description": "Per-site token used to sign or authenticate ingest."
          },
          "signature": {
            "type": "string",
            "description": "Signed integrity token for the ingest envelope."
          },
          "payload": {
            "type": "object",
            "description": "Versioned ingest payload containing connector metadata and facts only; message bodies are not allowed.",
            "required": ["items"],
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["type", "data"],
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "data": {
                      "type": "object"
                    },
                    "message": {
                      "not": {}
                    },
                    "messages": {
                      "not": {}
                    },
                    "message_body": {
                      "not": {}
                    },
                    "body": {
                      "not": {}
                    }
                  },
                  "additionalProperties": true,
                  "not": {
                    "anyOf": [
                      {
                        "required": ["message"]
                      },
                      {
                        "required": ["messages"]
                      },
                      {
                        "required": ["message_body"]
                      },
                      {
                        "required": ["body"]
                      }
                    ]
                  }
                }
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": false,
        "not": {
          "anyOf": [
            {
              "required": ["message"]
            },
            {
              "required": ["messages"]
            },
            {
              "required": ["message_body"]
            },
            {
              "required": ["body"]
            }
          ]
        }
      },
      "ConnectorIngestAcceptedResponse": {
        "type": "object",
        "required": ["accepted", "version"],
        "properties": {
          "accepted": {
            "type": "boolean",
            "const": true
          },
          "version": {
            "type": "string",
            "enum": ["v1"]
          },
          "received_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
